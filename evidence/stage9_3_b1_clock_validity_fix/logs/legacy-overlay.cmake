function(add_fixed_rt)
  foreach(dir IN ITEMS tests/host tests/stage9_1 tests/stage9_2)
    get_property(targets DIRECTORY "${CMAKE_SOURCE_DIR}/${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
      get_target_property(sources "${target}" SOURCES)
      if("${CMAKE_SOURCE_DIR}/kernel/scheduler.c" IN_LIST sources)
        list(REMOVE_ITEM sources "${CMAKE_SOURCE_DIR}/kernel/task.c")
        list(APPEND sources "${B1_SOURCE}/kernel/task.c" "${B1_SOURCE}/kernel/diag_rt.c")
        set_property(TARGET "${target}" PROPERTY SOURCES "${sources}")
        target_include_directories("${target}" BEFORE PRIVATE "${B1_SOURCE}/include" "${B1_SOURCE}/kernel")
      endif()
    endforeach()
  endforeach()
endfunction()
cmake_language(DEFER CALL add_fixed_rt)
