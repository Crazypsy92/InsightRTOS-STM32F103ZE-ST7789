{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "O2",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "INSIGHT_RTOS_ENABLED": "OFF",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG"
            }
        },
        {
            "name": "RTOS_Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "INSIGHT_RTOS_ENABLED": "ON"
            }
        },
        {
            "name": "RTOS_O2",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "INSIGHT_RTOS_ENABLED": "ON",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG"
            }
        },
        {
            "name": "DISPLAY_RTOS_Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "INSIGHT_RTOS_ENABLED": "ON",
                "INSIGHT_DISPLAY_RTOS": "ON",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG"
            }
        },
        {
            "name": "DISPLAY_RTOS_O2",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "INSIGHT_RTOS_ENABLED": "ON",
                "INSIGHT_DISPLAY_RTOS": "ON",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG"
            }
        },
        {
            "name": "DISPLAY_RTOS_Debug_Trace",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "INSIGHT_RTOS_ENABLED": "ON",
                "INSIGHT_DISPLAY_RTOS": "ON",
                "INSIGHT_TRACE_ENABLED": "ON",
                "INSIGHT_DIAG_EXPLAIN": "ON",
                "INSIGHT_DIAG_DL": "ON",
                "INSIGHT_DIAG_RT": "ON",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG"
            }
        },
        {
            "name": "DISPLAY_RTOS_O2_Trace",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "INSIGHT_RTOS_ENABLED": "ON",
                "INSIGHT_DISPLAY_RTOS": "ON",
                "INSIGHT_TRACE_ENABLED": "ON",
                "INSIGHT_DIAG_EXPLAIN": "ON",
                "INSIGHT_DIAG_DL": "ON",
                "INSIGHT_DIAG_RT": "ON",
                "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "O2",
            "configurePreset": "O2"
        },
        {
            "name": "RTOS_Debug",
            "configurePreset": "RTOS_Debug"
        },
        {
            "name": "RTOS_O2",
            "configurePreset": "RTOS_O2"
        },
        {
            "name": "DISPLAY_RTOS_Debug",
            "configurePreset": "DISPLAY_RTOS_Debug"
        },
        {
            "name": "DISPLAY_RTOS_O2",
            "configurePreset": "DISPLAY_RTOS_O2"
        },
        {
            "name": "DISPLAY_RTOS_Debug_Trace",
            "configurePreset": "DISPLAY_RTOS_Debug_Trace"
        },
        {
            "name": "DISPLAY_RTOS_O2_Trace",
            "configurePreset": "DISPLAY_RTOS_O2_Trace"
        }
    ]
}
